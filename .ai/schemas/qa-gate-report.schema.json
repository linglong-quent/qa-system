{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "QA Gate Report Contract",
    "description": "qa_gate.py --json 输出的门禁契约（编排系统：队长/成员/任务DAG 的机器接口）。schema_version=1.0",
    "type": "object",
    "required": [
        "schema_version",
        "run_id",
        "generated_at",
        "tool",
        "project",
        "verdict",
        "exit_code",
        "blocked",
        "bypass",
        "source_report",
        "summary",
        "gates",
        "tasks"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "1.0"
        },
        "run_id": {
            "type": "string",
            "description": "run 标识；空串表示未启用 run 隔离"
        },
        "generated_at": {
            "type": "string",
            "format": "date-time"
        },
        "tool": {
            "type": "object",
            "required": [
                "name",
                "version",
                "gate_architecture",
                "gate"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                },
                "gate_architecture": {
                    "type": "string"
                },
                "gate": {
                    "type": "string",
                    "description": "all 或单个 Gate 号"
                }
            }
        },
        "project": {
            "type": "object",
            "required": [
                "name",
                "root",
                "zero_pollution"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "root": {
                    "type": "string"
                },
                "zero_pollution": {
                    "type": "boolean"
                }
            }
        },
        "verdict": {
            "type": "string",
            "enum": [
                "ALLOW",
                "DENY",
                "BYPASS",
                "ERROR"
            ]
        },
        "exit_code": {
            "type": "integer",
            "enum": [
                0,
                1,
                2
            ],
            "description": "0=ALLOW/BYPASS, 1=DENY, 2=技术性错误"
        },
        "blocked": {
            "type": "boolean",
            "description": "verdict == DENY"
        },
        "bypass": {
            "type": "object",
            "required": [
                "applied",
                "reason"
            ],
            "properties": {
                "applied": {
                    "type": "boolean"
                },
                "reason": {
                    "type": "string"
                },
                "env": {
                    "type": "string"
                },
                "requested_by": {
                    "type": "string"
                },
                "hint": {
                    "type": "string"
                }
            }
        },
        "source_report": {
            "type": "object",
            "required": [
                "path",
                "found"
            ],
            "properties": {
                "path": {
                    "type": "string"
                },
                "found": {
                    "type": "boolean"
                },
                "errors": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "total_issues": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "timestamp": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "summary": {
            "type": "object",
            "required": [
                "gates_total",
                "gates_passed",
                "gates_failed",
                "gates_blocking_failed",
                "tasks_total",
                "tasks_blocking",
                "tasks_advisory",
                "tasks_signal",
                "signal_ratio"
            ],
            "properties": {
                "gates_total": {
                    "type": "integer",
                    "minimum": 0
                },
                "gates_passed": {
                    "type": "integer",
                    "minimum": 0
                },
                "gates_failed": {
                    "type": "integer",
                    "minimum": 0
                },
                "gates_blocking_failed": {
                    "type": "integer",
                    "minimum": 0
                },
                "tasks_total": {
                    "type": "integer",
                    "minimum": 0
                },
                "tasks_blocking": {
                    "type": "integer",
                    "minimum": 0
                },
                "tasks_advisory": {
                    "type": "integer",
                    "minimum": 0
                },
                "tasks_signal": {
                    "type": "integer",
                    "minimum": 0
                },
                "signal_ratio": {
                    "type": "number",
                    "minimum": 0
                }
            }
        },
        "gates": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "passed",
                    "severity",
                    "blocking",
                    "detail"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "passed": {
                        "type": "boolean"
                    },
                    "severity": {
                        "type": "string",
                        "enum": [
                            "BLOCKER",
                            "WARN",
                            "INFO",
                            "ADVISORY"
                        ]
                    },
                    "blocking": {
                        "type": "boolean"
                    },
                    "bypassed": {
                        "type": "boolean"
                    },
                    "detail": {
                        "type": "string"
                    }
                }
            }
        },
        "tasks": {
            "type": "array",
            "description": "可派发任务；task_id 为稳定幂等键（sha1(checker|rule|file|line|message)[:12]）",
            "items": {
                "type": "object",
                "required": [
                    "task_id",
                    "idempotency_key",
                    "gate",
                    "checker",
                    "rule_id",
                    "severity",
                    "blocking",
                    "file",
                    "line",
                    "message",
                    "fix_hint",
                    "depends_on"
                ],
                "properties": {
                    "task_id": {
                        "type": "string",
                        "minLength": 8
                    },
                    "idempotency_key": {
                        "type": "string"
                    },
                    "gate": {
                        "type": "string"
                    },
                    "checker": {
                        "type": "string"
                    },
                    "rule_id": {
                        "type": "string"
                    },
                    "severity": {
                        "type": "string",
                        "enum": [
                            "BLOCKER",
                            "WARN",
                            "INFO",
                            "ADVISORY"
                        ]
                    },
                    "blocking": {
                        "type": "boolean"
                    },
                    "file": {
                        "type": "string"
                    },
                    "line": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "message": {
                        "type": "string"
                    },
                    "fix_hint": {
                        "type": "string"
                    },
                    "depends_on": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "artifacts": {
            "type": "object"
        },
        "errors": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "additionalProperties": true
}